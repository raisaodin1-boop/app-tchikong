{
  "name": "app-tchikong",
  "version": "1.0.0",
  "description": "Logiciel de gestion scolaire - Groupe Scolaire Bilingue TCHIKONG",
  "main": "out/main/index.js",
  "author": "Groupe Scolaire TCHIKONG",
  "license": "MIT",
  "engines": {
    "node": ">=20 <=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.469.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "sql.js": "^1.14.1",
    "uuid": "^11.0.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "com.tchikong.gestion",
    "productName": "TCHIKONG Gestion Scolaire",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "db/migrations/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "publish": null
  }
}
